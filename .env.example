# Leave unset (or MOCK_LLM=1) to run the full flow offline with deterministic mock models.
MOCK_LLM=1

# Set either key to use real models (MOCK_LLM must not be 1).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ed25519 signing key (32-byte hex). Generated automatically into data/signing-key.json if unset.
# DEFEND_IT_SIGNING_SEED=

# Base URL used in receipts, QR codes, and verify links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite path (default: ./data/defend-it.db)
# DATABASE_PATH=./data/defend-it.db
