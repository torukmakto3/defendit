# Leave unset (or MOCK_LLM=1) to run the full flow offline with deterministic mock models.
MOCK_LLM=1

# Prefer a provider: liquid | ollama | groq | openrouter | openai | anthropic
# LLM_PROVIDER=liquid

# --- Liquid Inference (inference.ai.exchange) ---
# Put the secret in .env.local (gitignored). Never commit it and never paste it into a Grok Bot.
# LIQUID_API_KEY=
# LIQUID_MODEL=llama-3.3-70b-instruct
# LIQUID_MODEL_B=qwen3-14b
# LIQUID_CAP_USD=0.05
# LIQUID_BASE_URL=https://router.inference.ai.exchange/v1
# Also set a no-training guardrail on the key in the Liquid console.
# Grading refuses liquid.auto and pins LIQUID_MODEL / LIQUID_MODEL_B.
# Every call sends x-liquid-retention: none.

# --- Cheap / open-weight beta path ---
# Groq (Llama etc., OpenAI-compatible)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL_B=llama-3.1-8b-instant

# OpenRouter (many open-weight models)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_MODEL_B=qwen/qwen-2.5-72b-instruct

# Local Ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_MODEL_B=qwen2.5

# Generic OpenAI-compatible (vLLM, LM Studio, …)
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=local-model

# --- Optional frontier ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Fast decision sidecar (TypeSafe Jev — not generative) ---
# JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest

# Voice: text (default) | elevenlabs | openai-realtime | oss-cascade (planned)
# VOICE_PROVIDER=text
# ELEVENLABS_API_KEY=

# Ed25519 signing key (32-byte hex). Generated automatically into data/signing-key.json if unset.
# DEFEND_IT_SIGNING_SEED=

# Base URL used in receipts, QR codes, and verify links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite path (default: ./data/defend-it.db)
# DATABASE_PATH=./data/defend-it.db
