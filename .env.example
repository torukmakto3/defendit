# ---------------------------------------------------------------------------
# Local dev needs nothing: mock models, SQLite in ./data, auto-generated keys,
# sign-in links shown on screen. Deployments must set the REQUIRED block.
# ---------------------------------------------------------------------------

# --- REQUIRED on any deployment (Vercel sets VERCEL=1, which enforces these) ---
# Plus one model provider (below). A deployment with no provider refuses to grade
# unless MOCK_LLM=1 is set explicitly (test deploys only).
# Postgres (Neon / Vercel Postgres / Supabase). Unset = local SQLite file.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# 32-byte keys as 64 hex chars:  openssl rand -hex 32
# DEFEND_IT_SIGNING_SEED=      # Ed25519 receipt signing key. Rotating it invalidates old receipts' key match.
# DATA_ENCRYPTION_KEY=         # AES-256-GCM key for document text, claims, transcripts at rest.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# CRON_SECRET=                 # Vercel Cron sends it to /api/cron/purge

# --- Sign in ---
# Google (production). Web client in Google Cloud Console → Credentials.
# Authorized JavaScript origins:
#   https://defendit-two.vercel.app
#   http://localhost:3000
# Authorized redirect URIs (exact; path is /api/auth/google/callback):
#   https://defendit-two.vercel.app/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
# The redirect URI is APP_URL (or NEXT_PUBLIC_APP_URL, else https://$VERCEL_PROJECT_PRODUCTION_URL)
# plus /api/auth/google/callback. The button is hidden when either Google variable is unset.
# While the OAuth consent screen is in Testing, add the Google account as a test user.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_URL=https://defendit-two.vercel.app
# Magic links via Resend, kept for when a sending domain is ready.
# RESEND_API_KEY=
# EMAIL_FROM="Defend It <signin@yourdomain.com>"
# On-screen dev links. Local dev shows them. Preview can, with AUTH_DEV_LINKS=1.
# VERCEL_ENV=production never shows them, even if AUTH_DEV_LINKS=1. Admin emails never
# get an on-screen link. Restrict preview addresses when you do enable it:
# AUTH_DEV_LINKS=1
# AUTH_DEV_LINK_ALLOW=*@example.com,qa@yourdomain.com
# Comma-separated admin emails, matched case-insensitively to the verified Google
# email (or a magic-link email). A Hotmail address works only when that address is
# verified on the Google account you sign in with — a different Gmail is not admin.
# ADMIN_EMAILS=luisnunez1940@hotmail.com

# --- Models ---
# Unset every key (or MOCK_LLM=1) for deterministic offline mocks.
# MOCK_LLM=1
# Artificial pause per flashcard while MOCK_LLM is on, so card 1 can render before the deck finishes.
# MOCK_FLASHCARD_DELAY_MS=0
# Force a provider: liquid | openrouter | ollama | groq | openai-compat
# LLM_PROVIDER=liquid

# Liquid Inference (default when set). Every call sends retention_policy=none
# plus provider_requirements, so only zero-retention providers can serve it.
# LIQUID_API_KEY=
# LIQUID_MODEL=liquid.auto                 # primary model for claims, Learn, and question wording
# Flashcards use a small pinned Liquid model when LIQUID_API_KEY is set.
# FLASHCARD_MODEL=llama-3.1-8b-instruct
# Grading council. Comma-separated pinned model ids. A deployment refuses to
# grade if any member is a router (*.auto) or the list has fewer than 2.
# These three are pinned Liquid models (JSON mode and a seed, different families).
# LIQUID_COUNCIL_MODELS=gpt-oss-120b,deepseek-v3.2,llama-3.3-70b-instruct
# GRADING_SEED=0                           # integer seed stored with each grade. Default 0.
# LIQUID_CAP_USD=0.05                      # max charge per call
# Per-plan defense cap. SESSION_BUDGET_USD_CONSUMER and SESSION_BUDGET_USD_ENTERPRISE
# win when set. When a tier variable is unset, consumer is $0.75 and enterprise
# is $3. A legacy SESSION_BUDGET_USD does not replace those defaults. It is only
# the fallback for defenses stored before per-plan caps (sessions.budget_usd is
# null). Until plans land, everyone is a consumer except admins and that allowlist.
# SESSION_BUDGET_USD_CONSUMER=0.75
# SESSION_BUDGET_USD_ENTERPRISE=3
# SESSION_BUDGET_USD=3
# COST_TIER_ENTERPRISE_EMAILS=finance@yourdomain.com,*@internal.example
# Predicted cost reserved before each model call. Optional calls are skipped,
# and required calls move to CHEAP_LLM_MODEL, when the reserve would pass the cap.
# LLM_CALL_RESERVE_USD=0.05
# CHEAP_LLM_RESERVE_USD=0.01
# CHEAP_LLM_MODEL=llama-3.1-8b-instruct
# LiveKit voice, USD per minute. The agent reports session, STT, and TTS time.
# LIVEKIT_RATE_AGENT_MIN=0.01
# LIVEKIT_RATE_STT_MIN=0.0048
# LIVEKIT_RATE_TTS_MIN=0.009
# How many completed defenses the admin cost summary covers. Default 50.
# COST_REPORT_LIMIT=50
# Used only when the provider omits a dollar cost. USD per million tokens.
# LLM_PRICE_INPUT_PER_MTOK=0.15
# LLM_PRICE_OUTPUT_PER_MTOK=0.60
# LIQUID_REQUIRE_CLAIMS=zero_retention
# LIQUID_CHECKED_ONLY=1                    # reviewer-checked claims only: strictest, but slow (27-87s/call, Oct 2026)

# OpenRouter, restricted to zero-data-retention endpoints (provider.zdr=true)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_MODEL_B=qwen/qwen-2.5-72b-instruct

# Local Ollama / OpenAI-compatible server (treated as private when on localhost)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_COMPAT_MODEL=local-model
# Cheap model on that same server when a defense is over its cap. When this is
# unset, the capped call uses OPENAI_COMPAT_MODEL (the primary compat model)
# and the server logs that once. It does not read CHEAP_LLM_MODEL.
# OPENAI_COMPAT_CHEAP_MODEL=

# Providers that can't enforce zero retention per request (Groq, OpenAI, Anthropic,
# remote compat servers) are refused unless you accept the risk explicitly:
# LLM_ALLOW_UNVERIFIED_RETENTION=1
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_TIMEOUT_MS=45000
# One council member, including one retry, is dropped after this.
# Default 55000. Values above the grading cap (~59s) are clamped so the
# council still fits the 120s defend route.
# GRADER_TIMEOUT_MS=55000
# Wait before the one retry on 503 overloaded or 404 model_not_found.
# GRADER_RETRY_BASE_MS=250
# Extra random wait, 0 up to this many milliseconds, added to the base.
# GRADER_RETRY_JITTER_MS=500

# --- Data lifecycle ---
# DOCUMENT_TTL_HOURS=72        # extracted text for Learn-only use (deleted at defense completion regardless)
# RETENTION_DAYS=30            # claims, transcripts, grades, file names
# MAX_UPLOAD_BYTES=4194304     # Vercel functions cap request bodies at ~4.5 MB

# --- Billing (stubbed; no payment secrets) ---
# Off unless this is exactly 1 or true. Checkout and webhooks then answer
# "billing not enabled" and do not call a payment provider. No Stripe keys
# are read. Leave this false until billing is intentionally switched on.
# BILLING_ENABLED=false
# Euro budget for defenses paid with beta credits. Default 150.
# BETA_BUDGET_EUR=150
# What one sponsored defense counts against that budget. Default 0.70,
# about the $0.75 consumer cost cap, so the 150 euro ceiling is real.
# BETA_DEFENSE_EUR=0.70
# Free defenses granted once per account. Default 3. There is no further
# top-up while billing is off; the next defense answers that they are used up.
# The global budget above can stop a sponsored defense before this runs out.
# BETA_DEFENSE_CREDITS=3
# Gift challenges included each subscription period. Default 5. Raise later
# (the price list allows 15 once measured cost is low enough).
# SUBSCRIPTION_CHALLENGE_CREDITS=5

# --- Rate limits (positive integers; unset = the default) ---
# One database limiter. Keys are per account, per hashed email, or per keyed hash of the IP.
# The rate-limit table does not store the raw address. A bad value is logged and the default is used.
# IP_HASH_SALT is 64 hex characters. If it is missing or not 64 hex, the server
# logs an error and keeps serving. IP-keyed limits are skipped, anonymous result
# views are not counted, and the address is not stored. DEMO_IP_SALT is accepted
# when IP_HASH_SALT is unset or not 64 hex.
# IP_HASH_SALT=                 # openssl rand -hex 32
# Challenge attempt caps use the same limiter. Their names are in the challenge section below.
# Magic-link sends: 5 per email and 20 per IP, each per 15 minutes.
# RATE_LIMIT_LOGIN_EMAIL=5
# RATE_LIMIT_LOGIN_EMAIL_WINDOW_SEC=900
# RATE_LIMIT_LOGIN_IP=20
# RATE_LIMIT_LOGIN_IP_WINDOW_SEC=900
# Uploads (drop, receiver upload, Learn re-upload): 20 per account and 30 per IP, per 24 hours.
# RATE_LIMIT_UPLOAD_USER=20
# RATE_LIMIT_UPLOAD_USER_WINDOW_SEC=86400
# RATE_LIMIT_UPLOAD_IP=30
# RATE_LIMIT_UPLOAD_IP_WINDOW_SEC=86400
# Session start (Learn or Defend): 60 per account and 30 per IP, per hour.
# RATE_LIMIT_SESSION_START_USER=60
# RATE_LIMIT_SESSION_START_USER_WINDOW_SEC=3600
# RATE_LIMIT_SESSION_START_IP=30
# RATE_LIMIT_SESSION_START_IP_WINDOW_SEC=3600
# RATE_LIMIT_LEARN_TURN_USER=120
# RATE_LIMIT_LEARN_TURN_USER_WINDOW_SEC=3600
# RATE_LIMIT_DEFEND_ANSWER_USER=300
# RATE_LIMIT_DEFEND_ANSWER_USER_WINDOW_SEC=3600
# Paste and focus-loss updates during a defense: 600 per account, per hour.
# RATE_LIMIT_DEFEND_SIGNALS_USER=600
# RATE_LIMIT_DEFEND_SIGNALS_USER_WINDOW_SEC=3600
# RATE_LIMIT_DEFEND_COMPLETE_USER=20
# RATE_LIMIT_DEFEND_COMPLETE_USER_WINDOW_SEC=86400
# RATE_LIMIT_REQUEST_CREATE_USER=50
# RATE_LIMIT_REQUEST_CREATE_USER_WINDOW_SEC=86400
# Anonymous analytics beacon: 120 a minute for everyone, plus 30 a minute and 300 a day
# per keyed IP hash. Those per-address buckets are skipped when IP_HASH_SALT is unset.
# The global cap still applies. GET /api/stats is 60 an hour per keyed IP hash, and
# that check is skipped when the salt is unset.
# RATE_LIMIT_ANALYTICS_BEACON=120
# RATE_LIMIT_ANALYTICS_BEACON_WINDOW_SEC=60
# RATE_LIMIT_ANALYTICS_BEACON_IP=30
# RATE_LIMIT_ANALYTICS_BEACON_IP_WINDOW_SEC=60
# RATE_LIMIT_ANALYTICS_BEACON_IP_DAY=300
# RATE_LIMIT_ANALYTICS_BEACON_IP_DAY_WINDOW_SEC=86400
# RATE_LIMIT_STATS_READ=60
# RATE_LIMIT_STATS_READ_WINDOW_SEC=3600

# --- Analytics ---
# First-party funnel counts in analytics_events. On unless set to false or 0.
# No cookies, no third-party tracker, no IP, no user agent. Events older than
# 90 days are deleted by /api/cron/purge. DNT and Sec-GPC skip the visit beacon.
# Beacon limits are keyed on the HMAC in IP_HASH_SALT. See the rate-limit section.
# ANALYTICS_ENABLED=true
# Challenge steps also require CHALLENGES_ENABLED=1 (challenge links, off by default).
# Bearer token for GET /api/stats (counts only, no account or document fields).
# Unset answers 404. A wrong token answers 401.
# STATS_TOKEN=

# --- Voice: text (default) | elevenlabs | openai-realtime ---
# VOICE_PROVIDER selects the web interview modality. It does not pick the
# LiveKit interviewer's speech model. That is TTS_PROVIDER, below.
# VOICE_PROVIDER=text

# --- LiveKit interviewer speech (agent/). Default is Deepgram Aura-2 Thalia. ---
# xai uses Grok TTS voice Ara through LiveKit Inference. No XAI_API_KEY:
# the Node agent has no xAI plugin. Optional TTS_VOICE is an xAI voice id.
# See docs/voice-evaluation.md.
# TTS_PROVIDER=deepgram
# TTS_VOICE=ara
# Optional paraphrase before TTS. Off by default: a rules pass already turns
# filenames and field dumps into speech, in well under 500 ms. Set this on the
# web app and the LiveKit agent together. SPEECH_REWRITE_MODEL pins a Liquid
# model for that call only. A slow or code-like answer falls back to the rules.
# SPEECH_REWRITE_LLM=1
# SPEECH_REWRITE_MODEL=

# --- Challenge links (free beta). Default off. Paid path stays off and never calls Stripe. ---
# CHALLENGES_ENABLED=1
# BILLING_ENABLED=                 # leave unset. Paid challenges then stay off. There is no Stripe client.
# Unfinished challenges one challenger may have at once, and how many they may create per 24h.
# CHALLENGE_OPEN_PER_CREATOR=3
# CHALLENGE_DAILY_PER_CREATOR=3
# Claimed, not-yet-finished challenges one defender may hold. The database
# unique index enforces one, so a higher number does not raise the cap.
# CHALLENGE_OPEN_PER_DEFENDER=1
# Provisional global daily cap while the real number is still open.
# The euro budget is the credit ledger's BETA_BUDGET_EUR. A beta challenge
# defense reserves BETA_DEFENSE_EUR on that counter when the defense starts.
# Decline, expiry, and revoke release the reservation. Creating a challenge
# holds one challenge credit and does not keep a second reserve. A finished
# defense consumes that credit, whatever is published. Decline, expiry, and
# revoke refund the credit too.
# CHALLENGE_GLOBAL_DAILY_CAP=25
# BETA_BUDGET_EUR=150
# CHALLENGE_UNCLAIMED_DAYS=7
# CHALLENGE_FINISH_HOURS=72       # time to finish after accepting. Matches the document TTL.
# CHALLENGE_MIN_ACCOUNT_AGE_HOURS=0
# Attempt limits on the shared rate limiter, separate from the caps above.
# IP buckets store a keyed hash of the address (IP_HASH_SALT). Windows are seconds.
# CHALLENGE_CREATE_LIMIT=10
# CHALLENGE_CREATE_WINDOW_SEC=86400
# Claims and declines share these two budgets. The counters stay separate.
# CHALLENGE_CLAIM_LIMIT=20
# CHALLENGE_CLAIM_WINDOW_SEC=86400
# CHALLENGE_CLAIM_IP_LIMIT=30
# CHALLENGE_CLAIM_IP_WINDOW_SEC=3600
# Public share clicks and result-page views, per hashed IP.
# CHALLENGE_SHARE_LIMIT=30
# CHALLENGE_SHARE_WINDOW_SEC=3600
# CHALLENGE_RESULT_VIEW_LIMIT=60
# CHALLENGE_RESULT_VIEW_WINDOW_SEC=3600
# CHALLENGE_REPORT_LIMIT=10
# CHALLENGE_REPORT_WINDOW_SEC=3600
